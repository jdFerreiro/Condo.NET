{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "assets": {
        "ClusterId": "assetsCluster",
        "Match": { "Path": "/assets/{**catch-all}" },
        "Transforms": [
          {
            "PathRemovePrefix": "/assets"
          }
        ]
      },
      "booking": {
        "ClusterId": "bookingCluster",
        "Match": { "Path": "/booking/{**catch-all}" },
        "Transforms": [
          {
            "PathRemovePrefix": "/booking"
          }
        ]
      },
      "auth": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth"
          }
        ]
      },
      "financial": {
        "ClusterId": "financialCluster",
        "Match": { "Path": "/financial/{**catch-all}" },
        "Transforms": [
          {
            "PathRemovePrefix": "/financial"
          }
        ]
      },
      "accounting": {
        "ClusterId": "accountingCluster",
        "Match": { "Path": "/accounting/{**catch-all}" },
        "Transforms": [
          {
            "PathRemovePrefix": "/accounting"
          }
        ]
      },
      "engagement": {
        "ClusterId": "engagementCluster",
        "Match": { "Path": "/engagement/{**catch-all}" },
        "Transforms": [
          {
            "PathRemovePrefix": "/engagement"
          }
        ]
      }
    }
  }
}
