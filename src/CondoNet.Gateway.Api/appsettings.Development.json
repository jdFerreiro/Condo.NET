{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AuthService": {
    "Url": "http://localhost:8010/"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:80"
      },
      "Https": {
        "Url": "https://localhost:443"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "userRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/user/{**catch-all}" }
      },
      "apikeyRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/apikey/{**catch-all}" }
      },
      "passwordRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/password/{**catch-all}" }
      },
      "accountingRoute": {
        "ClusterId": "accountingCluster",
        "Match": { "Path": "/api/accounting/{**catch-all}" }
      },
      "assetsRoute": {
        "ClusterId": "assetsCluster",
        "Match": { "Path": "/api/assets/{**catch-all}" }
      },
      "bookingRoute": {
        "ClusterId": "bookingCluster",
        "Match": { "Path": "/api/booking/{**catch-all}" }
      },
      "engagementRoute": {
        "ClusterId": "engagementCluster",
        "Match": { "Path": "/api/engagement/{**catch-all}" }
      },
      "financialRoute": {
        "ClusterId": "financialCluster",
        "Match": { "Path": "/api/financial/{**catch-all}" }
      },
      "paymentRoute": {
        "ClusterId": "paymentCluster",
        "Match": { "Path": "/api/payment/{**catch-all}" }
      }
    },
    "Clusters": {
      "accountingCluster": {
        "Destinations": {
          "accounting_http": { "Address": "http://localhost:8030/" },
          //"accounting_https": { "Address": "https://localhost:44330/" }
        }
      },
      "assetsCluster": {
        "Destinations": {
          "assets_http": { "Address": "http://localhost:8020/" },
          //"assets_https": { "Address": "https://localhost:44320/" }
        }
      },
      "authCluster": {
        "Destinations": {
          "auth_http": { "Address": "http://localhost:8010/" },
          //"auth_https": { "Address": "https://localhost:44310/" }
        }
      },
      "bookingCluster": {
        "Destinations": {
          "booking_http": { "Address": "http://localhost:8040/" },
          //"booking_https": { "Address": "https://localhost:44340/" }
        }
      },
      "engagementCluster": {
        "Destinations": {
          "engagement_http": { "Address": "http://localhost:8050/" },
          //"engagement_https": { "Address": "https://localhost:44350/" }
        }
      },
      "financialCluster": {
        "Destinations": {
          "financial_http": { "Address": "http://localhost:8060/" },
          //"financial_https": { "Address": "https://localhost:44360/" }
        }
      },
      "paymentCluster": {
        "Destinations": {
          "payment_http": { "Address": "http://localhost:8070/" },
          //"payment_https": { "Address": "https://localhost:44370/" }
        }
      }
    }
  }
}
