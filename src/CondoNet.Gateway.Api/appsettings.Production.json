{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:80"
      },
      "Https": {
        "Url": "https://0.0.0.0:443"
      }
    }
  },
  "AuthService": {
    "Url": "http://condonet_auth:80/"
  },
  "Clusters": {
    "authCluster": {
      "Destinations": {
        "authApi": { "Address": "http://condonet_auth:80/" }
      }
    },
    "accountingCluster": {
      "Destinations": {
        "accountingApi": { "Address": "http://condonet_accounting:80/" }
      }
    },
    "assetsCluster": {
      "Destinations": {
        "assetsApi": { "Address": "http://condonet_assets:80/" }
      }
    },
    "bookingCluster": {
      "Destinations": {
        "bookingApi": { "Address": "http://condonet_booking:80/" }
      }
    },
    "engagementCluster": {
      "Destinations": {
        "engagementApi": { "Address": "http://condonet_engagement:80/" }
      }
    },
    "financialCluster": {
      "Destinations": {
        "financialApi": { "Address": "http://condonet_financial:80/" }
      }
    },
    "paymentCluster": {
      "Destinations": {
        "paymentApi": { "Address": "http://condonet_payment:80/" }
      }
    }
  }
}
